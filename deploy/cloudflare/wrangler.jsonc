{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Orchestration only. This Worker decides WHAT should run and records what
  // did; it never runs a model and never captures a feed. See ../bring-your-own/.
  "name": "wildlife-orchestrator",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",

  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  },

  // Cron expressions are UTC. Changes take up to 15 minutes to propagate.
  //
  // The sweep runs on a lag rather than at midnight for the day just ended,
  // because capture and transfer are still settling then and a campaign that
  // reads a half-uploaded day records a coverage gap that never existed.
  "triggers": {
    "crons": [
      "0 9 * * *",   // daily sweep, lagging the capture day
      "*/30 * * * *" // lease reaper: reclaim compute past its lease
    ]
  },

  "r2_buckets": [
    {
      "binding": "LAKE",
      "bucket_name": "<CF_PREFIX>-lake"
    },
    {
      "binding": "SITE_ASSETS",
      "bucket_name": "<CF_PREFIX>-site-assets"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "WORK",
        "queue": "<CF_PREFIX>-inference-work"
      }
    ],
    "consumers": [
      {
        "queue": "<CF_PREFIX>-inference-work",
        // Small batches: each message is a unit of GPU work measured in
        // minutes, so batching buys nothing and a large batch loses more
        // on a retry.
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        // Required, not optional. Without it a poison message retries until
        // it ages out and the failure is invisible.
        "dead_letter_queue": "<CF_PREFIX>-inference-dlq",
        "max_concurrency": 4
      }
    ]
  },

  "kv_namespaces": [
    {
      "binding": "RUN_STATE",
      // Replace with the id printed by setup.sh. Wrangler does not resolve
      // KV namespaces by name.
      "id": "<namespace-id-from-setup>"
    }
  ],

  // Optional. A generated JSON file is enough for a few hundred reports.
  "d1_databases": [
    {
      "binding": "REPORT_INDEX",
      "database_name": "<CF_PREFIX>-report-index",
      "database_id": "<d1-database-id>"
    }
  ]

  // Secrets are NOT declared here. Set them with:
  //   npx wrangler secret put COMPUTE_API_TOKEN
  // Anything in this file is committed; anything in a secret is not.
}
