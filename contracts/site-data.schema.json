{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rain-Brian/cascadia-listening-post/contracts/site-data.schema.json",
  "title": "Site roll-up",
  "description": "The machine-readable index of the whole site, generated from every report.json. Nothing here is scraped from a rendered page. That is the guarantee that makes site-level figures checkable: a claim that exists only in a page's prose cannot become a site-level number, because no code path reads prose.",
  "type": "object",
  "required": ["schema_version", "generated_at", "site", "metrics", "featured_findings", "reports"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "site": {
      "type": "object",
      "required": ["name", "url", "tagline"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "tagline": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Summed from the report records, and rendered directly as the landing page tiles. Derive them; never maintain them.",
      "required": ["reports", "featured", "reviewed", "usable_hours", "days_covered"],
      "properties": {
        "reports": { "type": "integer", "minimum": 0 },
        "featured": { "type": "integer", "minimum": 0 },
        "reviewed": { "type": "integer", "minimum": 0, "description": "Reports a person has judged, as distinct from published." },
        "usable_hours": { "type": "number", "minimum": 0, "description": "Sums only reports that record an hours figure. Reports whose coverage is counted another way contribute nothing here, so this is a floor rather than a total." },
        "days_covered": { "type": "integer", "minimum": 0 }
      }
    },
    "featured_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary", "domain", "review_status", "report_id"],
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "domain": { "type": "string" },
          "review_status": { "type": "string" },
          "report_id": { "type": "string" },
          "report_title": { "type": "string" },
          "media": { "type": ["object", "null"] }
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["report_id", "title", "generated_at", "domains", "review_status", "models"],
        "properties": {
          "report_id": { "type": "string" },
          "title": { "type": "string" },
          "generated_at": { "type": "string", "format": "date-time" },
          "domains": { "type": "array", "items": { "type": "string" } },
          "coverage": {
            "type": ["string", "null"],
            "description": "Coverage as a phrase, because the unit differs by domain: hours of usable signal for audio, source segments or frames for video. Rendered, not computed on."
          },
          "review_status": { "type": "string" },
          "models": { "type": "array" }
        }
      }
    }
  }
}
